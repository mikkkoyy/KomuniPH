# --------------------------------------------------------------------- #
# KomuniPH Lite — Git exclusions
# --------------------------------------------------------------------- #

# Secrets — never commit a real .env
.env
.env.*
!.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.next/
out/

# Runtime
*.log
logs/
*.db
*.db-shm
*.db-wal
*.db-journal
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Temporary debug/test scripts and outputs (prefix-based)
.tmp-*
